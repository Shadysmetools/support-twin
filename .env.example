# support-twin environment. Copy to .env (the install scripts do this) and fill in what you use.
# `support-twin` loads ./.env on start; existing environment variables always win.
# Secrets for integrations (Telegram, Gmail, Odoo, WhatsApp...) do NOT go here: store them in the local vault with
#   support-twin creds set <name>
# so they are never written to disk in plain text.

# Where config/, data/ and logs live. The install scripts point this at ./.twin inside the checkout.
TWIN_AGENT_HOME=./.twin

# Optional: a separate persona/profile YAML (otherwise the `profile:` section of $TWIN_AGENT_HOME/config/config.yaml).
# TWIN_PROFILE=./my-profile.yaml

# Optional: where the encrypted local vault lives (default: inside TWIN_AGENT_HOME).
# TWIN_AGENT_VAULT_DIR=

# Optional model keys. The default reasoning backend is a local Claude Code session and needs no key here.
# GROQ_API_KEY=            # voice-note transcription (Whisper) and the optional cross-model refuter
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=
# VERTEX_PROJECT=
