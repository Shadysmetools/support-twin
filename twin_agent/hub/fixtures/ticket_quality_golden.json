{
  "_schema": {
    "description": "Ticket-quality golden set: FICTIONAL clients and paraphrased messages only, no PII. Each case is turned into the Odoo ticket (title + description) and checked against the rubric in evalharness.TicketQualityEval.",
    "rubric": [
      "title has client + module + problem in plain English",
      "every description section present, in order",
      "original message preserved (escaped)",
      "no invented facts (no attachments/steps/urgency the client did not give; module 'not identified' when unknown)",
      "type and urgency correct"
    ],
    "item": {
      "id": "",
      "client": "fictional client name",
      "partner_id": "synthetic id",
      "kind": "text|voice|media",
      "lang": "en|ar|mixed",
      "input": "the client's message / transcript",
      "translation": "the English a TicketWriter should give (fake writer fixture)",
      "gt_type": "",
      "gt_module": "module name or 'unknown'",
      "gt_urgency": "High|not stated",
      "attachments": "substrings expected in Attachments",
      "steps": "steps the client gave",
      "follow_up": "previous ticket id if a follow-up",
      "context_modules": "client-context modules"
    }
  },
