{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Principal's Agent worker packet (the only thing a worker produces). Code check: twin_agent.schemas.validate_packet",
  "type": "object",
  "required": ["request_id", "class", "tier", "company", "understanding", "evidence", "verified", "draft_reply",
               "after_fix_reply", "proposed_action", "ticket_draft", "questions_for_principal", "runbook_occurrence",
               "note", "confidence"],
  "properties": {
    "request_id": {"type": "string", "pattern": "^REQ-[0-9]{4,}(-[a-c])?$"},
    "class": {"type": "string", "minLength": 1, "description": "runbook class slug, 'RB <slug>' or 'unknown'"},
    "tier": {"enum": ["T1", "T2a", "T2b", "T3", "T4", "UNKNOWN"]},
    "track": {"enum": ["functional", "development", null],
              "description": "Ticket Analyst track: functional = no code (setting, view, data, Studio, automation, a question); development = code, a module or a bug in custom code"},
    "ticket_type": {"enum": ["bug", "new_request", "configuration", "inquiries", "customization", null],
                    "description": "functional: bug | new_request | configuration | inquiries; development: bug | new_request | customization"},
    "company": {"enum": ["EG", "KSA", "UNKNOWN"]},
    "understanding": {"type": "string", "minLength": 1},
    "analysis": {"type": ["string", "null"], "maxLength": 400,
                 "description": "ONE sentence for Principal's approval card: the cause plus the record links that prove it"},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["kind"],
      "properties": {"kind": {"enum": ["runbook", "odoo_read", "past_answer", "memory", "thread", "ocr"]},
                     "id": {"type": "string"}, "status": {"type": "string"}, "model": {"type": "string"},
                     "field": {"type": "string"}, "source": {"type": "string"}}}},
    "verified": {"type": "boolean", "description": "IGNORED: recomputed in code (guards.recompute_verified)"},
    "draft_reply": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["channel", "lang", "text"],
      "properties": {"channel": {"type": "string"}, "lang": {"enum": ["en", "franco", "ar"]}, "text": {"type": "string"}}}]},
    "after_fix_reply": {"type": ["string", "null"]},
    "proposed_action": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["type"],
      "properties": {"type": {"enum": ["run_this", "ui_steps", "ticket", "approver_question"]},
                     "records": {"type": "array", "items": {"type": "string"}},
                     "approver": {"description": "IGNORED: recomputed in code (guards.recompute_exemption)"},
                     "script": {"description": "IGNORED: the listener writes fix.py"},
                     "sha256": {"description": "IGNORED: computed by the listener"}}}]},
    "ticket_draft": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["parts"],
      "properties": {"parts": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "object",
        "required": ["part", "type", "subject", "body"],
        "properties": {"part": {"enum": ["a", "b", "c"]}, "type": {"enum": ["inquiry", "functional", "dev"]},
                       "subject": {"type": "string"}, "body": {"type": "string"}}}}}}]},
    "questions_for_principal": {"type": "array", "items": {"type": "string"}},
    "runbook_occurrence": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["entry"],
      "properties": {"entry": {"type": "string"}, "date": {"type": "string"}, "record": {"type": "string"},
                     "status": {"const": "provisional"}}}]},
    "note": {"type": "string", "description": "at most 15 lines; becomes NOTE.md"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
